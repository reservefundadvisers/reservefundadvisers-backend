function list_pagination(parent, formatters, options = {}, get_url = "", get_params = {}, set_url, del_url, callbacks){

    
    // specify element containing table to be transformed
    if(parent.length < 2){
        return null;
    }
    
    var e = $(parent);


    if(e.length < 1 || e.find(parent+"_table").length < 1)
        return null;

    e.find(parent+"_table").addClass('invisible');

    get_params['pagination'] = 'true';

    options["pagination"] = "remote";
    if(options['ajaxURL'] == undefined)options['ajaxURL'] = get_url;
    if(options['ajaxParams'] == undefined)options['ajaxParams'] = get_params;
    if(options['paginationSize'] == undefined)options['paginationSize'] = 50;
    if(options['paginationInitialPage'] == undefined)options['paginationInitialPage'] = 1;


    var table_count = e.find(parent+"_count");
    var table_select_count = e.find(parent+"_select_count");

    var total = undefined;

    var tableLoader = null;
    var startLoading = function(){ if(tableLoader)return; tableLoader = loading('', $(parent)); }
    var clearLoading = function(){ if(tableLoader){tableLoader.remove();} tableLoader = null;}
    
   
    var isParentPerc = e.find(parent+"_table").parent().css('height').indexOf('%') >= 0 ;
    var isSingleSelect = e.find(parent+"_table").hasClass('single-select');


    var table_options = {
        
        height: isParentPerc ? '100%' : 600,
        layout:"fitColumns",
        columnMinWidth:110,
        persistenceMode:"local",
        persistence:{ columns: ["width"] },
        
        dataLoading:function(data){

            
                                      
                        //console.log('loading at:'+(now() - elapsed)); elapsedLoad = now();
                        //data - the data loading into the table
                        
                            clearLoading();
                            startLoading();

                                                                    
                        //console.log(data);
                                                                    
                        var i = 1;
                        for(var d of data){
                            if(d)d.row_num = i++;
                        }
                        

                        if(formatters && formatters.dataFormatter && data){
                            data = formatters.dataFormatter(data);
                        }
                        
                    },

        dataLoaded: function(data){

                        //console.log(data);
                        
                        //console.log('loaded in:'+(now() - elapsedLoad));
                        if(total == undefined)total = data.length;
            
                        if(table){
                            table_count.html(total || table.getDataCount());
                            table_select_count.html(table.getSelectedRows().length);
                            //console.log('loaded: '+table.getDataCount())                            
                        }
                        
                        //console.log('total since request:'+(now() - elapsed));
                        
                        if(table)if(callbacks)callbacks();

                        table_init_inputs(parent+"_table", set_url);

                        //console.log('loaded in: '+(now() - elapsed)); elapsed = now();
                        
                        clearLoading();

                        callbacks({'event':'loaded'});
                        
                    },
                    
        ajaxRequesting:function(url, params){
                        //url - the URL of the request
                        //params - the parameters passed with the request
                        //console.log(url, params);
                        //ajax_get_no_loading(url, params, function(resp){console.log(resp)}, function(err){console.log(err.responseText); });
                        //console.log('requesting'); elapsed = now();
                        startLoading();
                    },
        ajaxResponse:function(url, params, response){
                        //console.log(response)
                        //console.log('responded in: '+(now() - elapsed));
                                                
                        clearLoading();
                        
                        if(response.error){
                            error(response.error);
                            return;
                        }

                        if(callbacks){
                            callbacks({'event':'ajax', 'url':url, 'params':params, 'response':response});
                        }

                        total = response.total || undefined;
                        return response;
                    },
        ajaxError:function(err){
                        error("Couldn't retrieve list.", '', default_error_alert_timeout); console.log(err);
                        if(callbacks)callbacks();
                        clearLoading();
                    },

        dataChanged: function(data){
                            
                            //console.log('changed: ', total, data.length);
                            if(table){
                                table_count.html(total || table.getDataCount());
                                table_select_count.html(table.getSelectedRows().length);
                            }    
                            if(callbacks)callbacks();    

                            
                            callbacks({'event':'changed'});
                            
                    },

        rowAdded : function(row){                                                     
                        total++; if(table){table_count.html(total); }
                    },
                    

        dataSorting:function(){
                        //console.log('sorting at:'+(now() - elapsedLoad));
                        startLoading();
                    },
        dataSorted:function(sorters, rows){
                        //sorters - array of the sorters currently applied
                        //rows - array of row components in their new order
                        //if(rows.length > 0)

                        clearLoading();
                        //console.log('sorted at:'+(now() - elapsedLoad));
                        
                        callbacks({'event':'sorted'});
                    },

        rowSelectionChanged:function(data, rows){
                        table_select_count.html(formatNumber(rows.length, 0))
                        if(callbacks)callbacks({'event':'selection', 'data':data, 'rows':rows});
                    },
        rowDeleted:function(row){
                        total--; 
                        setTimeout(function(){if(total < 0)total = 0; table_count.html(total);}, 100);
                        
                    },

        rowFormatter:function(row){
            
                        if(formatters){
                            
                            if(formatters.rowFormatter)
                                formatters.rowFormatter(row, function(id, value, withoutUiUpdate){updateCb(id, value, 'table', withoutUiUpdate)});
                         
                            if(callbacks)callbacks();  

                            //console.log('formatted '+row.getData().row_num+' in: '+(now() - elapsedRow)); 

                        }
                
                    },
        rowClick: function(e, row){
                            
                    }
    };


    for(const opt in options){
        if(opt == 'columnHeaderPadding' || opt == 'ajaxURL' || opt == 'ajaxURL' || opt == 'rowSelectOnClick')continue;
            table_options[opt] = options[opt];
    }

    
    if(isSingleSelect){ table_options['selectable'] = 1; }


    // init table
    var table_element = e.find(parent+"_table");
    var table = new Tabulator(table_element[0], table_options); 

    table_element = $(table.element);
    
    // make grid selectable and hide header checkbox if it's single selection
    if(isSingleSelect){
        table_element.find('.row_select').find('input').addClass('d-none');
    }
    
    

    table_element.removeClass('invisible');

    var obj = {"table": table};
    
    
    obj.toggleColumns = function(){
            var columns = table.getColumns(true);
            for(col of columns){
                e = $(col.getElement());
                var togglable = e.hasClass('togglable');
                if(!togglable)continue;

                col.toggle();
            }
            
    }

    if($(table.element).hasClass('start-toggled')){
        obj.toggleColumns();
    }


    
    var tableNewParams = {};
    obj.refresh = function(resetFilterAndSearch){                         
                            
                        if(resetFilterAndSearch == true){                   
                            if(options.ajaxParams['filter'])delete options.ajaxParams['filter'];
                            if(options.ajaxParams['search'])delete options.ajaxParams['search'];                      
                        }

                        tableNewParams = {};
                        for(var p in tableNewParams){ options.ajaxParams[p] = tableNewParams[p]; }

                        options.ajaxParams['page'] = table.getPage();
                        table.setData(options.ajaxURL, options.ajaxParams);
                    }

    
    obj.delete = function(cb){

                        var list = {};
                        for(const item of table.getSelectedRows()){
                            if(item.getData().id){
                                var tmp = {};
                                list[item.getData().id] =  item.getData();
                                //list.push(tmp);
                            }
                            
                        }


                        list = Object.keys(list);
                        //console.log('Deleting: ', list)

                        if(list.length > 0){
                            delete_elements({'id': list}, del_url, 
                                            function(ok){

                                                if(!ok)return;

                                                if(list.length < 5 )
                                                    table.deleteRow(list);
                                                else 
                                                    obj.refresh();
                                                    
                                                if(cb)cb(list);

                                            }, true);
                        }
                        
                    }

    obj.update = function(id, value){
        updateCb(id, value);
    }

    obj.add = function(data){
        if(typeof data == 'object'){
            data.row_num = table.getDataCount() + 1;
        }else if(Array.isArray(data)){
            var c = table.getDataCount() + 1;
            for(var i=0; i<data.length; i++){
                data[i].row_num = c+i;
            }
        }
        table.addRow(data, true);
    }

    obj.selected = function(isRows){
        if(isRows)
            return table.getSelectedRows();
        else 
            return table.getSelectedData();
    }

    obj.setRowSelectOnClick = function(selectable){
        rowSelectOnClick = selectable;
    }

    obj.remoteSearch = function(search){
        //console.log(options, options.ajaxURL, options.ajaxParams.params, search);
        
        var params = options.ajaxParams;
        if(!search) delete params['search'];
        else params['search'] = search;
        if(table)table.setData(options.ajaxURL, params );
    }

    obj.remoteFilter = function(filters){
        //console.log(options, options.ajaxURL, options.ajaxParams.params, filters);
        
        var params = options.ajaxParams;
        if(!filters) delete params['filter'];
        else params['filter'] = filters;
        if(table)table.setData(options.ajaxURL, params );
    }

    obj.clearFilter = function(p){ table.clearFilter(p); }

    table.setData([]);

    setTimeout(function(){ table.setData(options.ajaxURL, options.ajaxParams || {}); }, 10);

    return obj;
}

