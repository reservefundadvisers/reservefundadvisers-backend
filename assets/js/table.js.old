    }


    obj.clearFilter = function(p){ table.clearFilter(p); }

    obj.setData = function(data){ table.setData(data); }

    table.setData(list);


    return obj;
}


function table_init_inputs(table, set_url, propCb){

    if(!table)return;

    var el = typeof table == 'string' ? $(table) : table;


    // init dropdown elements        
    el.find(".dropdown-toggle").dropdown();

        
    el.find('.global-prop-chk').change(function(event){
        
        event.preventDefault();
        event.stopImmediatePropagation();

        var item = $(this);
        var isChecked = item.is(':checked');

        if(propCb && propCb(item, "checked", {type:"checkbox", "checked":isChecked}) == false)return;

        var id = item.data('id'), key = item.data('key');
        if(id === undefined || key === undefined)return;
        //if(value === undefined)value = "";
        
        if(propCb && propCb(item, "before", {"id": id, "key": key, "type": "checkbox", "checked":isChecked}) == false)return;
        
        var options = {}; options['id'] = id; options[key] = isChecked ? 1 : 0;
        set_property(set_url, options, function(resp){
            
            console.log(resp);

            if(resp && resp.error){
                error(handleError(resp.error));
                item.prop('checked', !isChecked).trigger('updateState');
                return;
            }else if((resp && resp.success === undefined) || !resp){
                item.prop('checked', !isChecked).trigger('updateState');
                return;
            }

            
        if(propCb && propCb(item, "done", {"id": id, "key": key, "type": "checkbox", "checked":isChecked}) == false)return;
            
        }, item.closest('label'));

    });
    
    el.find('.global-prop-btn').click(function(event){
        
        event.preventDefault();
        event.stopImmediatePropagation();

        var item = $(this);
        
        if(propCb && propCb(item, "clicked") == false)return;

        var id = item.data('id'), key = item.data('key'), value = item.data('value');
        if(id === undefined || key === undefined)return;
        if(value === undefined)value = "";
        
        if(propCb && propCb(item, "before", {'id': id, 'key': key, 'value': value, 'type': 'button'}) == false)return;
        
        var l = loading('', item.closest('td'));

        var options = {'id': id}; options[key] = value;
        set_property(set_url, options, function(resp){
            
            l.remove();
            if(resp && resp.error){
                error(handleError(resp.error));
                return;
            }

            if(propCb)propCb(item, "done", {'id': id, 'key': key, 'value': value, 'type': 'button'});

            
        });

    });     
}