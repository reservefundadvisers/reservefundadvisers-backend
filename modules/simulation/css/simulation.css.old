
:root {
    --simulation_options_top:  10px; /* 120px; */
    --simulation_options_width: 500px;
    --simulation_options_height: 640px;
    --simulation_bar_height_transition_dur: height 0.25s linear ;
}


/* header */

.tabulator .tabulator-header .tabulator-col{   
    height: 100px !important;
    width: 120px;
}

.tabulator .tabulator-header .tabulator-col .tabulator-col-content .tabulator-col-title {   
    white-space: break-spaces !important;
    text-align: center;
}

.tabulator-col.purple{
    background-color: #673ab7 !important;
    color: #fff!important;
}


.tabulator-col.green{
    background-color: #4CAF50 !important;
    color: #fff!important;
}

.tabulator-col.amber{
    background-color: #ffc107 !important;
    color: #000!important;
}

.tabulator-col.red{
    background-color: var(--danger) !important;
    color: #fff;
}


.tabulator-col.ltim{
    background-color: #8ac28c !important;
    color: #000000!important;
}

/* ***** */




/* Cells */

.tabulator-cell.cell-bold{
    font-weight: bold !important;
}

.tabulator-cell{
    text-align: right;
    padding-right: 10px !important;
    border-right: 1px solid lightGray !important;
}

.tabulator-cell.cell-left{
    text-align: left;
}

.tabulator-cell.cell-green{
    background-color: #4CAF50;
    color: #fff;
}

.tabulator-cell.cell-amber{
    background-color: #ffc107;
    color: #000;
}

.tabulator-cell.cell-purple{
    background-color: #673ab7;
    color: #fff;
}


.tabulator-cell.cell-red{
    background-color: var(--danger);
    color: #fff;
}

.tabulator-cell.cell-ltim{
    background-color: #8ac28c;
    color: #000000;
}



.tabulator-cell.cell-text-green{
    color: #4CAF50;
}

.tabulator-cell.cell-text-amber{
    color: #ffc107;
}

.tabulator-cell.cell-text-purple{
    color: #673ab7;
}


.tabulator-cell.cell-text-red{
    color: var(--danger);
}

.tabulator-cell.cell-text-ltim{
    color: #8ac28c;
}

/* ***** */


/* Tabs */

.simulation-tab-nav-group{
    color: black;
    white-space: nowrap !important;
    /* flex-wrap: nowrap;
    overflow: hidden;
    position: relative; */
    padding: 0rem 2.3rem;
}
.simulation-tab-nav-group-left{
    position: absolute;
    padding: 0rem 0.8rem;
    padding-top: 0.8rem;
    /* border-radius: 25%; */
    background: white;
    top: 0;
    bottom: 0;
    left: 0;
    margin:0;
    cursor: pointer;
    border-right: 1px solid var(--dark);
}
.simulation-tab-nav-group-left:hover{
    color:var(--blue);
}
.simulation-tab-nav-group-right{
    position: absolute;
    padding: 0rem 0.8rem;
    padding-top: 0.8rem;
    /* border-radius: 25%; */
    background: white;
    top: 0;
    bottom: 0;
    right: 0;
    margin:0;
    cursor: pointer;
    border-left: 1px solid var(--dark);
    
}
.simulation-tab-nav-group-right:hover{
    color:var(--blue);
}

.simulation-tab-nav{
    border: 1px solid var(--dark) !important;
    margin-right:0.2rem !important;
}

.simulation-tab-nav.active{
    color: white !important;
    background-color: var(--primary) !important;
    border-color: #dddfeb #dddfeb #fff !important;
    font-weight: normal !important;
}


.simulation-tab-nav.ltim {
    background-color: var(--green);
    color: white !important;    
    font-weight: normal !important;
}



/* ***** */



/* Model Association */
.simulation-association-btn{

    width:100%;
    border: 1px solid gray;
    border-radius: 0.5rem;

    box-shadow: 0 0.15rem 0.6rem 0 rgba(58, 59, 69, 0.15) !important;

    padding: 0.5rem 0.5rem;

    text-align: center;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary);
    
}

.simulation-association-btn:hover{
    cursor: pointer;
    background-color: var(--green);
    color: white;
}

.simulation-model-btn{

    width:100%;
    border: 1px solid gray;
    border-radius: 0.5rem;

    box-shadow: 0 0.15rem 0.6rem 0 rgba(58, 59, 69, 0.15) !important;

    padding: 0.5rem 0.5rem;

    text-align: center;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary);
    
}

.simulation-model-btn:hover{
    cursor: pointer;
    background-color: var(--green);
    color: white;
}


.simulation-options{
    width: var(--simulation_options_width); 
    /* height: var(--simulation_options_height);  */
    top:var(--simulation_options_top); 
    left:0; 
    z-index:2; 
    bottom: 24px;
    display:none;
    
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10+ */
    user-select: none;
    
    /* display:flex; 
    flex-direction:column; 
    bottom: 24px; */
}
/* ***** */





/* Timeline */

#simulation_timeline.pad{
    padding-left: calc( var(--simulation_options_width) + 20px);
}



.simulation-timeline-col{
    border-radius: 10px;
    cursor: pointer;
    padding-top:0.5rem;
    padding-bottom:0.5rem;
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10+ */
    user-select: none;
}
.simulation-timeline-col:hover{
    background-color: #eee;
}
.simulation-timeline-col.active{
    background-color: #ccc;
}

/* Year Circle */
.simulation-timeline-year{
    background: white;
    color:black;
}
.simulation-timeline-year.managed{
    background: var(--orange);
    color:white;
}
.simulation-timeline-year-start{
    border-radius: 8px 0px 0px 8px;
}
.simulation-timeline-year-end{
    border-radius: 0px 8px 8px 0px;
}


/* Value Text */
.simulation-timeline-value-text{
    background-color: white;
    border-radius: 10px;
    top:0;
    left:0;
    right:0;
    margin:auto;
    z-index:1;
    padding: 0rem 0.5rem;
}
.simulation-timeline-col[data-positive="true"]:hover .simulation-timeline-value-text,
.simulation-timeline-col[data-positive="true"].active .simulation-timeline-value-text {
    background-color: #4CAF50;
    color: white !important;
}
.simulation-timeline-col[data-positive="false"]:hover .simulation-timeline-value-text,
.simulation-timeline-col[data-positive="false"].active .simulation-timeline-value-text{
    background-color: var(--danger);
    color: white !important;
}

/* Positive */
.simulation-timeline-positive-bar{
    width:55%;
    background: #4CAF50;
    border-radius: 8px;
    z-index:1;
    visibility:hidden;
    position: absolute;
    transition: var(--simulation_bar_height_transition_dur);
    overflow:hidden;
    /* bottom:0; */
    
}
.simulation-timeline-positive-bar-ghost{
    width:55%;
    outline:0.2rem solid #155217;
    border-radius: 8px;
    z-index:1;
    position: absolute;
    transition: var(--simulation_bar_height_transition_dur);
    /* visibility:hidden; */

    
}
.simulation-timeline-positive-bar-ltim{
    width:100%;
    height: 0%;
    background-color: #9c27b0;        
}
.simulation-timeline-positive-line{
    position:absolute;
    background: #4CAF50;
    width:0.2rem;
    bottom:0;
    height:6.5rem;
    left:0;
    right:0;
    margin:auto;
    visibility:hidden;
    
}

/* Negative */
.simulation-timeline-negative-bar{
    width:55%;
    background: var(--danger);
    border-radius: 8px;
    z-index:1;
    visibility:hidden;
    position: absolute;
    transition: var(--simulation_bar_height_transition_dur);
    /* bottom:0; */
    
}
.simulation-timeline-negative-bar-ghost{
    width:55%;
    outline:0.2rem solid #641a1a;
    border-radius: 8px;
    z-index:1;
    position: absolute;
    transition: var(--simulation_bar_height_transition_dur);
    /* visibility:hidden; */

    
}
.simulation-timeline-negative-line-t-even{
    position:absolute;
    background: var(--danger);
    width:0.2rem;
    bottom:0;
    height:4.6rem;
    left:0;
    right:0;
    margin:auto;
    visibility:hidden;
    
}
.simulation-timeline-negative-line-t-odd{
    position:absolute;
    background: var(--danger);
    width:0.2rem;
    bottom:0;
    height:2.6rem;
    left:0;
    right:0;
    margin:auto;
    visibility:hidden;
    
}
.simulation-timeline-negative-line-b{
    position:absolute;
    background: var(--danger);
    width:0.2rem;
    top:0;
    height:2.5rem;
    left:0;
    right:0;
    margin:auto;
    visibility:hidden;
    
}

/* CASE 1: When Value is Positive, hide all negative classes */
.simulation-timeline-col[data-positive="true"] .simulation-timeline-negative-bar{ visibility:hidden; }
.simulation-timeline-col[data-positive="true"] .simulation-timeline-negative-line-t-even{ visibility:hidden; }
.simulation-timeline-col[data-positive="true"] .simulation-timeline-negative-line-t-odd{ visibility:hidden; }
.simulation-timeline-col[data-positive="true"] .simulation-timeline-negative-line-b{ visibility:hidden; }

/* CASE 1: When Value is Positive, show all positive classes */
.simulation-timeline-col[data-positive="true"] .simulation-timeline-positive-bar{ visibility:visible; }
.simulation-timeline-col[data-positive="true"] .simulation-timeline-positive-line{ visibility:visible; }


/* CASE 2: When Value is Negative, hide all positive classes */
.simulation-timeline-col[data-positive="false"] .simulation-timeline-positive-bar{ visibility:hidden; }
.simulation-timeline-col[data-positive="false"] .simulation-timeline-positive-line{ visibility:hidden; }

/* CASE 2: When Value is Negative, show all negative classes */
.simulation-timeline-col[data-positive="false"] .simulation-timeline-negative-bar{ visibility:visible; }
.simulation-timeline-col[data-positive="false"] .simulation-timeline-negative-line-t-even{ visibility:visible; }
.simulation-timeline-col[data-positive="false"] .simulation-timeline-negative-line-t-odd{ visibility:visible; }
.simulation-timeline-col[data-positive="false"] .simulation-timeline-negative-line-b{ visibility:visible; }


/* CASE 3: When Prev Value is Positive and New is Negative, show all negative classes, and positive as outline with line */
.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-negative-bar{ visibility:visible; }
.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-negative-line-t-even{ visibility:visible; }
.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-negative-line-t-odd{ visibility:visible; }
.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-negative-line-b{ visibility:visible; }

.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-positive-bar{ visibility:hidden; /* background-color: transparent; border:0.2rem solid #4CAF50; */ }
.simulation-timeline-col[data-prev-positive="true"] .simulation-timeline-positive-line{ visibility:visible; background: var(--danger);}


/* CASE 4: When Prev Value is Negative and New is Positive, show all positive classes, and negative as outline with line */
.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-negative-bar{ visibility:hidden; /* background-color: transparent; border:0.2rem solid var(--danger); */ }
.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-negative-line-t-even{ visibility:visible;  background: #4CAF50; }
.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-negative-line-t-odd{ visibility:visible;  background: #4CAF50;}
.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-negative-line-b{ visibility:visible;  background: #4CAF50; }

.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-positive-bar{ visibility:visible;}
.simulation-timeline-col[data-prev-positive="false"] .simulation-timeline-positive-line{ visibility:visible;}



/* Monthly Fees Timeline */
.simulation-timeline-mf{
    padding: 2.5rem 0rem 3.2rem 0rem;
}

.simulation-timeline-mf-col{
    border-radius: 4px;
    cursor: pointer;
    padding:0.6rem 0.5rem;
    box-sizing: border-box;
    width:2.5rem;
    height:6rem;
    transform: rotate(180deg);
    position: relative;
}

.simulation-timeline-mf-year{
    text-align: center;
    font-weight: bold;
    font-size: 1rem;
    transform: rotate(180deg);
    top:-1.2rem;
    left:0;
    right:0;
    margin: auto;
    position: absolute;
}

.simulation-timeline-mf-col:hover{
    background: #eee;
}

.simulation-timeline-mf-bar{
    width:50%;
    background: #f5d85a;
    border-radius: 0px 2px 2px 0px;
    float:left;
    transition: var(--simulation_bar_height_transition_dur);
}
/* .simulation-timeline-mf-bar:hover{
    background: #c0aa46;
} */

.simulation-timeline-mf-value{
    background-color: white;
    border-radius: 10px;
    bottom:-1.6rem;
    left:0;
    right:0;
    margin:auto;
    z-index:1;
    padding: 0rem 0.5rem;    
    position: absolute;
    transform: rotate(180deg);
    visibility: hidden;
}
.simulation-timeline-mf-value-text{
    color: #c9ac2e !important;
}
.simulation-timeline-mf-col:hover .simulation-timeline-mf-value-text{
    visibility: visible;
}

.simulation-timeline-mf-ltim-bar{
    width:50%;
    background: #9c27b0;
    border-radius: 2px 0px 0px 2px;
    float:left;
    transition: var(--simulation_bar_height_transition_dur);
    visibility: hidden;
}
.simulation-timeline-mf-col.is-ltim .simulation-timeline-mf-ltim-bar{
    visibility: visible;
}

.simulation-timeline-mf-ltim-value{
    background-color: white;
    border-radius: 10px;
    top:-2.6rem;
    left:0;
    right:0;
    margin:auto;
    z-index:1;
    padding: 0rem 0.5rem;    
    position: absolute;
    transform: rotate(180deg);
    visibility: hidden;
    opacity: 0 !important;
}
.simulation-timeline-mf-col.is-ltim .simulation-timeline-mf-ltim-value{
    opacity: 1 !important;
}
.simulation-timeline-mf-ltim-value-text{
    color: #9c27b0 !important;
}
.simulation-timeline-mf-col:hover .simulation-timeline-mf-ltim-value-text{
    visibility: visible;
}


/* Timeline Buttons */
.year-left{
    cursor: pointer;
    padding: 0.1rem 0.5rem;
    font-weight: bold;
    border-radius: 15px;
    float:left;
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10+ */
    user-select: none;
}
.year-left:hover{    
    background-color: var(--danger);
    color:white;
}
.year-right{
    cursor: pointer;
    padding: 0.1rem 0.5rem;
    font-weight: bold;
    border-radius: 15px;
    float:right;
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10+ */
    user-select: none;
}
.year-right:hover{    
    background-color: var(--blue);
    color:white;
}

/* ***** */