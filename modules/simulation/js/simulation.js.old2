                                chart_series.deficit_l.push((l.fa < 0 ? l.fa : 0).toFixed(2));

                                chart_series.cash_m.push((m.fa > 0 ? m.fa : 0).toFixed(2));
                                chart_series.cash_l.push((l.fa > 0 ? l.fa + l.ltim_acc : 0).toFixed(2));

                                console.log(l.fa, l.ltim_acc, l.fa + l.ltim_acc);

